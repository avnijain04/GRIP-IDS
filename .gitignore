# ===========================
# Model Files
# ===========================
# Ignore temporary or heavy checkpoints
models/*_temp*
models/*epoch*
models/*_round*.h5
models/*_global*.h5

# Keep best models for explainability + reproducibility
!models/*best*.keras
!models/*best*.h5

